---
// Spin — a live 2D Ising model. Scroll is temperature.
// Spec: docs/superpowers/specs/2026-09-24-spin-design.md
// Page framing: docs/superpowers/plans/2026-09-24-foundation-and-forge.md
import Base from '../../layouts/Base.astro';
---
<Base
  title="Spin — Archaic"
  description="A two-dimensional Ising model running live in your browser. Scroll to cool it from noise, through the critical point, into frozen domains."
  path="/forge/spin/"
  ogImage="/forge/spin/og.png"
  layout="spin"
  current="forge"
>
  <div class="gate" id="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title">
    <div class="gate-inner">
      <p class="gate-title" id="gate-title">THIS PAGE FLASHES</p>
      <p class="gate-text">It is a live physical simulation. At its hottest it becomes a rapidly flickering pattern across the whole screen. If flashing light affects you, go back.</p>
      <div class="gate-actions">
        <button class="gate-continue" id="begin" type="button">Continue</button>
        <a class="gate-back" href="/">Back</a>
      </div>
    </div>
  </div>

  <!-- What a crawler, a reader who asked for less motion, and anyone whose wasm
       never arrives actually sees. Hidden the moment a real frame is painted. -->
  <img class="poster" id="poster" src="/forge/spin/poster.webp" width="1600" height="1000" decoding="async"
       alt="A square lattice of the two-dimensional Ising model near its critical temperature: bone and black domains at every size, from single cells to patches that span the frame." />
  <canvas class="lattice" id="lattice" aria-hidden="true"></canvas>
  <div class="vignette" aria-hidden="true"></div>
  <div class="track" aria-hidden="true"></div>

  <main class="panel" id="panel">
    <h1 class="panel-title">SPIN</h1>
    <p class="panel-text">A two-dimensional Ising model, running live in your browser. Every cell is a spin that wants to match its neighbours. Heat fights that. At the top of the page it is hot, and the lattice is noise. At the bottom it is cold, and the lattice freezes into domains. In between, at one temperature, structure appears at every size at once. That point is why physicists still study this model. Scroll to cool it.</p>
    <p class="readout" role="status" aria-live="polite">
      <span class="readout-word" id="readout-word">HOT</span>
      <span class="readout-track" aria-hidden="true"><span class="readout-marker" id="readout-marker"></span></span>
    </p>
    <div class="controls">
      <button class="control" id="pause" type="button">Pause</button>
      <button class="control" id="reset" type="button">Reset</button>
      <button class="control" id="save" type="button">Save</button>
      <a class="control" href="https://github.com/faulknco/ising-rs" target="_blank" rel="noopener noreferrer">Source</a>
    </div>
  </main>
</Base>

<style is:global>
  /* The spin layout: the shared nav floats over the canvas and nothing else from
     the chrome comes with it. Global because Nav renders inside Base, so a
     scoped rule would never reach it. */
  .page--spin .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 2; }
  .page--spin .nav-link, .page--spin .nav-contact {
    color: var(--text);
    text-shadow: 0 0 12px var(--ground), 0 0 4px var(--ground);
  }
  .page--spin .nav-link:hover, .page--spin .nav-contact:hover { color: var(--text-display); }
  /* The page is one long scroll track with nothing under it. Without this, the
     ends of the track chain into the browser's own overscroll and pull-to-refresh. */
  body.spin { overscroll-behavior: none; }
  body.gated { overflow: hidden; }
</style>

<style>
  /* Scroll track: contributes scroll length and nothing else. */
  .track { height: 600vh; width: 100%; pointer-events: none; }

  .poster, canvas.lattice { position: fixed; inset: 0; width: 100vw; height: 100vh; display: block; }
  .poster { object-fit: cover; image-rendering: pixelated; z-index: 0; }
  /* display: block above is author-origin, so it outranks the user-agent sheet's
     [hidden] { display: none } and poster.hidden would set a property that
     changes nothing. Without this the still stays rendered — and described to a
     screen reader — underneath a live lattice the canvas is aria-hidden from. */
  .poster[hidden] { display: none; }
  canvas.lattice { image-rendering: pixelated; opacity: 0; transition: opacity 0.6s ease; z-index: 0; }
  canvas.lattice.live { opacity: 1; }

  /* Edge vignette, so the nav and the panel stay legible over bone. The top band
     holds near-opaque for the height of the nav and only then falls away: at the
     hot end the lattice is half bone, and a gradient that has already started
     fading behind the links leaves them sitting on noise. */
  .vignette {
    position: fixed; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(to bottom,
        rgb(var(--ground-rgb) / 0.97) 0,
        rgb(var(--ground-rgb) / 0.9) 100px,
        rgb(var(--ground-rgb) / 0) 280px),
      linear-gradient(to top, rgb(var(--ground-rgb) / 0.9), rgb(var(--ground-rgb) / 0) 180px);
  }

  .panel {
    position: fixed; left: var(--s-40); bottom: var(--s-32); z-index: 2;
    max-width: 46ch;
    padding: var(--s-20);
    background: rgb(var(--ground-rgb) / 0.96);
    border: 1px solid var(--panel-border);
  }
  .panel-title {
    font-family: var(--font-display); text-transform: uppercase;
    font-size: var(--fs-h2); font-weight: 400; letter-spacing: var(--ls-2); color: var(--text-display);
    margin-bottom: var(--s-10);
  }
  .panel-text { font-size: var(--fs-12); line-height: var(--lh-caption); color: var(--text); margin-bottom: var(--s-16); }

  /* Temperature: a word and a bar. No number appears anywhere on this page. */
  .readout { display: flex; align-items: center; gap: var(--s-14); margin-bottom: var(--s-16); }
  .readout-word {
    font-family: var(--font-display); text-transform: uppercase;
    font-size: var(--fs-10); letter-spacing: var(--ls-3); color: var(--text-display);
    min-width: 12ch;
  }
  .readout-track { position: relative; flex: 1; height: 1px; background: var(--rule-label); }
  .readout-marker {
    position: absolute; top: -3px; left: 0; width: 7px; height: 7px; margin-left: -3px;
    background: var(--text-display); transition: left 0.2s linear;
  }

  .controls { display: flex; flex-wrap: wrap; gap: var(--s-20); }
  .control {
    font: inherit; font-size: var(--fs-10); letter-spacing: var(--ls-2); text-transform: uppercase;
    color: var(--text-cta); background: none; border: 0; cursor: pointer; text-decoration: none;
    transition: color 0.3s; padding: 0;
  }
  .control:hover { color: var(--text-hover); }

  /* Photosensitivity gate: shown before anything moves. */
  .gate {
    position: fixed; inset: 0; z-index: 3;
    background: var(--ground);
    display: flex; align-items: center; justify-content: center;
    padding: var(--s-24);
  }
  .gate.closed { display: none; }
  .gate-inner { max-width: 44ch; }
  .gate-title {
    font-family: var(--font-display); text-transform: uppercase;
    font-size: var(--fs-h2); letter-spacing: var(--ls-2); color: var(--text-display);
    margin-bottom: var(--s-20);
  }
  .gate-text { font-size: var(--fs-13); line-height: var(--lh-body); color: var(--text); margin-bottom: var(--s-32); }
  .gate-actions { display: flex; gap: var(--s-32); align-items: center; }
  .gate-continue, .gate-back {
    font: inherit; font-size: var(--fs-10); letter-spacing: var(--ls-2); text-transform: uppercase;
    background: none; border: 0; cursor: pointer; text-decoration: none;
    color: var(--focus); transition: color 0.3s;
  }
  .gate-continue:hover, .gate-back:hover { color: var(--text-display); }

  @media (max-width: 640px) {
    /* The nav stacks and the links wrap onto two rows here, so it stands about
       twice as tall and the top band has to reach further down with it. */
    .vignette {
      background:
        linear-gradient(to bottom,
          rgb(var(--ground-rgb) / 0.97) 0,
          rgb(var(--ground-rgb) / 0.9) 180px,
          rgb(var(--ground-rgb) / 0) 340px),
        linear-gradient(to top, rgb(var(--ground-rgb) / 0.9), rgb(var(--ground-rgb) / 0) 180px);
    }
    .panel { left: var(--s-16); right: var(--s-16); bottom: var(--s-16); max-width: none; padding: var(--s-16); }
    .panel-text { font-size: var(--fs-11); }
  }
  @media (prefers-reduced-motion: reduce) {
    canvas.lattice { transition: none; }
    .readout-marker { transition: none; }
  }
</style>

<script type="module" is:inline>
  // is:inline because this imports runtime paths out of public/; Vite cannot
  // resolve them at build time and bundling the module breaks the worker URL.
  import { temperatureFor, readoutFor, T_HOT, T_COLD } from '/forge/spin/tmap.js';

  // ---- gate, wired first --------------------------------------------------
  // The gate covers the whole page and only Continue dismisses it, so its
  // listener goes on before any other work in this module. Anything that throws
  // further down then costs the reader that feature, not the page: the
  // alternative is a reader trapped behind a warning they cannot dismiss.
  const gate = document.getElementById('gate');
  const begin = document.getElementById('begin');
  begin.addEventListener('click', () => {
    try { sessionStorage.setItem('spin-gate', 'ok'); } catch {}
    start();
  });
  // Keep keyboard focus inside the gate while it is open (Continue <-> Back).
  gate.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || gate.classList.contains('closed')) return;
    const focusable = Array.from(gate.querySelectorAll('button, a[href]'));
    const first = focusable[0], lastItem = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); lastItem.focus(); }
    else if (!e.shiftKey && document.activeElement === lastItem) { e.preventDefault(); first.focus(); }
  });

  const N = 256;
  // The two spin states are the site's two colours, read from the tokens so
  // there is one definition of bone and of ground. The fallbacks are those same
  // two values written out: a missing token should cost the page its colours and
  // say so, not abort the module and take the gate down with it.
  // tests/tokens.test.mjs is what keeps these two in step with tokens.css.
  const BONE_FALLBACK = [232, 228, 216];
  const GROUND_FALLBACK = [6, 6, 6];
  function rgbToken(name, fallback) {
    const raw = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    const parts = raw.split(/[\s,]+/).map(Number);
    if (parts.length !== 3 || !parts.every(Number.isFinite)) {
      console.error(`spin: ${name} is not an "r g b" triplet (got "${raw}") — using the fallback`);
      return fallback;
    }
    return parts;
  }
  const UP = rgbToken('--bone-rgb', BONE_FALLBACK);
  const DOWN = rgbToken('--ground-rgb', GROUND_FALLBACK);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const canvas = document.getElementById('lattice');
  const poster = document.getElementById('poster');
  const ctx = canvas.getContext('2d', { alpha: false });
  const back = document.createElement('canvas');
  back.width = N; back.height = N;
  const bctx = back.getContext('2d', { alpha: false });
  const img = bctx.createImageData(N, N);

  let last = null;          // Int8Array of the last frame
  let frames = 0;
  let pending = false;      // a tick is in flight
  let visible = !document.hidden;
  let paused = false;       // the page has stopped asking for ticks
  let resets = 0;           // frames that came back flagged as a fresh draw

  // ---- rendering -------------------------------------------------------
  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.round(innerWidth * dpr);
    canvas.height = Math.round(innerHeight * dpr);
    ctx.imageSmoothingEnabled = false;
    if (last) paint();
  }
  function paint() {
    const d = img.data;
    for (let i = 0, j = 0; i < last.length; i++, j += 4) {
      const c = last[i] > 0 ? UP : DOWN;
      d[j] = c[0]; d[j + 1] = c[1]; d[j + 2] = c[2]; d[j + 3] = 255;
    }
    bctx.putImageData(img, 0, 0);
    const side = Math.max(canvas.width, canvas.height);
    const x = (canvas.width - side) / 2, y = (canvas.height - side) / 2;
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(back, x, y, side, side);
  }
  addEventListener('resize', resize);
  resize();

  // ---- scroll → temperature -------------------------------------------
  function scrollFraction() {
    const max = document.documentElement.scrollHeight - innerHeight;
    return max > 0 ? scrollY / max : 0;
  }
  const temperature = () => temperatureFor(scrollFraction());

  // ---- readout ---------------------------------------------------------
  const word = document.getElementById('readout-word');
  const marker = document.getElementById('readout-marker');
  function updateReadout() {
    const T = temperature();
    const w = readoutFor(T);
    // Only write when the word actually changes: the element is a live region,
    // and rewriting the same text on every scroll event would talk over itself.
    if (word.textContent !== w) word.textContent = w;
    marker.style.left = `${(100 * (T_HOT - T)) / (T_HOT - T_COLD)}%`;
  }
  addEventListener('scroll', updateReadout, { passive: true });
  updateReadout();

  // ---- worker (started only after the gate) -----------------------------
  let worker = null;
  function start() {
    if (worker) return;
    document.body.classList.remove('gated');
    document.getElementById('gate').classList.add('closed');
    worker = new Worker('/forge/spin/worker.js', { type: 'module' });
    worker.onmessage = onWorkerMessage;
    worker.onerror = (e) => console.error('spin worker failed:', e.message);
    worker.postMessage({ type: 'init', n: N, seed: Date.now() % 4294967296, maxSweeps: reduced ? 1 : 4 });
    // Someone who asked for less motion gets the still poster and a Run button.
    // Nothing moves until they ask for it: paused is already true when 'ready'
    // arrives, so loop() returns without posting a tick and no frame is painted.
    if (reduced) { paused = true; syncPauseLabel(); }
    else armIdle();
  }
  function onWorkerMessage(e) {
    const m = e.data;
    if (m.type === 'ready') { pending = false; schedule(); return; }
    if (m.type === 'frame') {
      last = new Int8Array(m.spins);
      frames++;
      // A reset frame is unsolicited — it answers no tick. Clearing pending here
      // would let the next frame post a second tick on top of the one already in
      // flight, and the two would stay in flight for the life of the page.
      if (m.reset) resets++; else pending = false;
      paint();
      if (frames === 1) { canvas.classList.add('live'); poster.hidden = true; }
      return;
    }
    if (m.type === 'error') console.error('spin worker:', m.message);
  }

  // schedule() is the only way in; loop() is only ever called by rAF. A callback
  // deferred while the tab was hidden fires after visibilitychange, so without
  // the flag every hide/show cycle left one more chain alive for the session.
  let looping = false;
  function schedule() {
    if (looping) return;
    looping = true;
    requestAnimationFrame(loop);
  }
  function loop() {
    looping = false;
    if (!visible || !worker || paused) return;
    if (!pending) { pending = true; worker.postMessage({ type: 'tick', T: temperature() }); }
    schedule();
  }
  // Pause stops the request side only. A tick already in flight still comes back
  // and paints one last frame; there is no way to recall it, and the worker has
  // no queue behind it, so nothing accumulates while paused.
  function pause() { paused = true; drifting = false; clearTimeout(idleTimer); }
  function resume() { if (!paused) return; paused = false; schedule(); armIdle(); }
  function reset() { if (worker) worker.postMessage({ type: 'reset' }); }
  document.addEventListener('visibilitychange', () => {
    visible = !document.hidden;
    if (visible) schedule();
  });

  // ---- idle drift -------------------------------------------------------
  const IDLE_MS = 15000;
  let idleTimer = null, drifting = false, dir = 1, selfScroll = false;
  function drift() {
    if (!drifting) return;
    const max = document.documentElement.scrollHeight - innerHeight;
    if (scrollY >= max - 1) dir = -1; else if (scrollY <= 1) dir = 1;
    selfScroll = true;
    scrollBy(0, dir * 0.6);
    requestAnimationFrame(() => { selfScroll = false; drift(); });
  }
  function armIdle() {
    drifting = false;
    clearTimeout(idleTimer);
    if (paused) return;   // a paused lattice must not be dragged by the drift
    if (reduced || !worker) return;
    idleTimer = setTimeout(() => { drifting = true; drift(); }, IDLE_MS);
  }
  for (const ev of ['wheel', 'touchstart', 'pointerdown', 'keydown']) addEventListener(ev, armIdle, { passive: true });
  addEventListener('scroll', () => { if (!selfScroll) armIdle(); }, { passive: true });

  // ---- controls ---------------------------------------------------------
  const pauseBtn = document.getElementById('pause');
  function syncPauseLabel() { pauseBtn.textContent = paused ? 'Run' : 'Pause'; }
  pauseBtn.addEventListener('click', () => { paused ? resume() : pause(); syncPauseLabel(); });
  document.getElementById('reset').addEventListener('click', reset);

  document.getElementById('save').addEventListener('click', () => {
    if (!last) return;
    const out = document.createElement('canvas');
    out.width = canvas.width; out.height = canvas.height;
    const octx = out.getContext('2d', { alpha: false });
    octx.imageSmoothingEnabled = false;
    const side = Math.max(out.width, out.height);
    octx.drawImage(back, (out.width - side) / 2, (out.height - side) / 2, side, side);
    out.toBlob((blob) => {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'archaic-spin.png';
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }, 'image/png');
  });

  // ---- test hook --------------------------------------------------------
  window.__spin = {
    get frames() { return frames; },
    get resets() { return resets; },
    get paused() { return paused; },
    temperature, pause, resume, reset,
    sample() {
      if (!last) return null;
      let up = 0, agree = 0;
      for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
        const s = last[y * N + x];
        if (s > 0) up++;
        const r = last[y * N + ((x + 1) % N)], d = last[((y + 1) % N) * N + x];
        if (r === s) agree++; if (d === s) agree++;
      }
      return { upFraction: up / (N * N), agreement: agree / (2 * N * N) };
    },
  };

  // ---- gate: the second visit ---------------------------------------------
  // Wired at the top of the module; only the auto-start is left here, because it
  // calls start(), which needs everything above it to be initialised.
  let seen = false;
  try { seen = sessionStorage.getItem('spin-gate') === 'ok'; } catch {}
  if (seen) start(); else begin.focus();
</script>
