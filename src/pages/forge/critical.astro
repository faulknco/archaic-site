---
// Critical — the same Ising model as Spin, held at one temperature, measured.
// Spec: docs/superpowers/specs/2026-09-25-forge-critical-design.md
import Base from '../../layouts/Base.astro';
// Where the critical temperature sits on the slider track, as a fraction of the
// range [1, 4]. Rendered on the server so the mark is right with no script.
const T_C = 2 / Math.log(1 + Math.SQRT2);
const tcFraction = ((T_C - 1) / 3).toFixed(5);
---
<Base
  title="Critical — Archaic"
  description="The two-dimensional Ising model held at one temperature. A slider, a live trace of the magnetisation, and a phase diagram that fills in as you measure it against Onsager's exact curve."
  path="/forge/critical/"
  ogImage="/forge/critical/og.png"
  layout="scroll"
  current="forge"
>
  <div class="gate" id="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title">
    <div class="gate-inner">
      <p class="gate-title" id="gate-title">THIS PAGE FLASHES</p>
      <p class="gate-text">It is a live physical simulation. At its hottest the lattice becomes a rapidly flickering pattern. If flashing light affects you, go back.</p>
      <div class="gate-actions">
        <button class="gate-continue" id="begin" type="button">Continue</button>
        <a class="gate-back" href="/forge/">Back</a>
      </div>
    </div>
  </div>

  <!-- The gate is a modal over a page whose other controls stay in the document,
       and `inert` is what takes them out of reach. The bench carries it from the
       server. The nav is Base's and renders before this slot, so a synchronous
       inline script marks it at parse time; the footer renders after the slot,
       so the module marks it before anyone can reach it. start() lifts all of
       them together. The same script closes the scroll while the gate is up. -->
  <script is:inline>
    document.body.classList.add('gated');
    document.querySelector('.page--scroll .nav')?.setAttribute('inert', '');
  </script>

  <div class="content">
    <header class="page-header">
      <h1 class="page-title">CRITICAL</h1>
      <p class="page-intro">The same model, held at one temperature. The point where it changes its mind.</p>
    </header>

    <section class="bench" id="bench" inert aria-label="The instrument">
      <div class="stage" id="stage">
        <!-- What a crawler, a reader who asked for less motion, and anyone whose
             wasm never arrives actually sees. Hidden once a real frame is painted. -->
        <img class="poster" id="poster" src="/forge/critical/poster.webp" width="800" height="800" decoding="async"
             alt="A square lattice of the two-dimensional Ising model held at its critical temperature: bone and black patches at every size, each made of smaller ones." />
        <canvas class="lattice" id="lattice" aria-hidden="true"></canvas>
      </div>

      <div class="panel">
        <div class="field">
          <label class="label" for="temp">Temperature</label>
          <div class="slider" style={`--tc: ${tcFraction}`}>
            <input type="range" id="temp" min="1" max="4" step="0.01" value="2.27" aria-valuetext="2.269, the critical temperature" />
            <span class="tc-mark" aria-hidden="true"><span class="tc-label">2.269</span></span>
          </div>
          <div class="slider-ends" aria-hidden="true"><span>1.0</span><span>4.0</span></div>
        </div>

        <p class="readout" aria-hidden="true">
          <span class="readout-item"><span class="readout-key">T</span> <span class="readout-val" id="t-val">2.269</span></span>
          <span class="readout-item"><span class="readout-key">|m|</span> <span class="readout-val" id="m-val">—</span></span>
          <span class="readout-word" id="phase-word">CRITICAL</span>
          <span class="readout-word readout-state" id="state-word">SETTLING</span>
        </p>
        <p class="sr-only" role="status" aria-live="polite" id="announce"></p>

        <figure class="chart chart--trace">
          <canvas id="trace" class="chart-canvas" aria-hidden="true"></canvas>
          <figcaption class="chart-caption">Magnetisation over the last few seconds. The faint line is where the exact solution says it should rest.</figcaption>
        </figure>

        <figure class="chart chart--phase">
          <div class="plot">
            <span class="axis-y" aria-hidden="true">|m|</span>
            <canvas id="phase" class="chart-canvas" aria-hidden="true"></canvas>
            <div class="axis-x" aria-hidden="true" style={`--tc: ${tcFraction}`}>
              <span class="axis-min">1.0</span><span class="axis-tc">2.269</span><span class="axis-max">4.0</span>
            </div>
          </div>
          <figcaption class="chart-caption">Magnetisation against temperature. The faint curve is Onsager's exact solution for the infinite lattice. The squares are what this lattice measured while you held it there.</figcaption>
        </figure>

        <div class="controls">
          <button class="control" id="reset" type="button">Reset</button>
          <button class="control" id="clear" type="button">Clear points</button>
          <a class="control" href="https://github.com/faulknco/ising-rs" target="_blank" rel="noopener noreferrer">Source</a>
        </div>
      </div>
    </section>

    <section class="prose" id="prose">
      <p>A phase transition is a change the rules never mention. Every cell in this lattice follows the same instruction at every temperature: match your neighbours where you can, and let heat argue otherwise. Nothing in that instruction says order or disorder. Below one temperature the lattice takes a side and holds it. Above it, it does not. The crossing between the two is sharp, and it belongs to the whole, not to any cell. Ice and water are the same molecules.</p>
      <p>At the critical point the lattice has no size of its own. Away from it a patch of agreement has a typical width, small when hot, the whole lattice when cold. As the temperature nears the critical value that width grows without bound, and at the point itself there are patches of every size at once, each made of smaller ones, each part of a larger one. Magnify the picture and it looks the same. That is why the curve falls so steeply there, and why the lattice seems to hesitate. It is the one temperature at which the model is still making up its mind, and it does so at every scale at once.</p>
    </section>
  </div>
</Base>

<style is:global>
  /* The gate closes the scroll while it is up. Global because body is Base's. */
  body.gated { overflow: hidden; }
</style>

<style>
  .content { position: relative; z-index: 10; max-width: 1040px; margin: 0 auto; padding: 0 var(--gutter); }
  .page-header { padding: var(--s-120) 0 var(--s-48); max-width: var(--measure); }
  .page-title { font-family: var(--font-display); font-size: var(--fs-h1); font-weight: 400; color: var(--text-display); letter-spacing: var(--ls-4); text-transform: uppercase; }
  .page-intro { font-size: var(--fs-14); color: var(--text); line-height: var(--lh-body); max-width: 520px; margin-top: var(--s-24); }

  /* ---- the bench: lattice left, instrument right ---------------------- */
  .bench { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-40); align-items: start; }
  .stage { position: relative; aspect-ratio: 1; width: 100%; max-width: 100%; background: var(--ground); border: 1px solid var(--panel-border); overflow: hidden; }
  .poster, canvas.lattice { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .poster { object-fit: cover; image-rendering: pixelated; }
  /* display: block above is author-origin and outranks the UA sheet's [hidden]
     rule; without this the still would stay rendered under a live lattice. */
  .poster[hidden] { display: none; }
  canvas.lattice { opacity: 0; transition: opacity 0.6s ease; }
  canvas.lattice.live { opacity: 1; }

  .panel { display: flex; flex-direction: column; gap: var(--s-24); }
  .label { display: block; font-size: var(--fs-9); letter-spacing: var(--ls-3); text-transform: uppercase; color: var(--text-label); margin-bottom: var(--s-14); }

  /* ---- slider ------------------------------------------------------------ */
  /* The thumb is 14px, so the track the thumb's centre actually travels is the
     input's width less 14px, inset by 7px. The critical mark is placed on that
     inner track, at --tc of it, so it sits under the thumb when the thumb is
     at the critical temperature. */
  .slider { position: relative; padding: 0 7px; }
  .slider input[type="range"] {
    -webkit-appearance: none; appearance: none;
    display: block; width: 100%; height: 28px; margin: 0; background: transparent; cursor: pointer;
  }
  .slider input[type="range"]::-webkit-slider-runnable-track { height: 1px; background: var(--rule-label); }
  .slider input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 14px; height: 14px; margin-top: -6.5px;
    background: var(--text-display); border: 0; border-radius: 0;
  }
  .slider input[type="range"]::-moz-range-track { height: 1px; background: var(--rule-label); }
  .slider input[type="range"]::-moz-range-thumb { width: 14px; height: 14px; background: var(--text-display); border: 0; border-radius: 0; }
  .slider input[type="range"]:focus-visible { outline: 1px solid var(--focus); outline-offset: 4px; }
  .tc-mark {
    position: absolute; top: 50%; left: calc(7px + (100% - 14px) * var(--tc));
    width: 1px; height: 18px; transform: translate(-50%, -50%);
    background: rgb(var(--copper-rgb)); pointer-events: none;
  }
  .tc-label {
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
    margin-top: var(--s-6); font-size: var(--fs-10); letter-spacing: var(--ls-1); color: rgb(var(--copper-rgb));
    white-space: nowrap;
  }
  .slider-ends { display: flex; justify-content: space-between; font-size: var(--fs-10); letter-spacing: var(--ls-1); color: var(--text-label); margin-top: var(--s-6); }

  /* ---- readout ------------------------------------------------------------ */
  .readout { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-10) var(--s-20); font-size: var(--fs-12); color: var(--text); margin-top: var(--s-8); }
  .readout-item { display: inline-flex; gap: var(--s-8); align-items: baseline; }
  .readout-key { font-size: var(--fs-10); letter-spacing: var(--ls-1); color: var(--text-label); }
  .readout-val { font-variant-numeric: tabular-nums; color: var(--text-display); min-width: 4ch; }
  .readout-word {
    font-family: var(--font-display); text-transform: uppercase;
    font-size: var(--fs-10); letter-spacing: var(--ls-3); color: var(--text-display);
  }
  .readout-state { color: var(--text-caption); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* ---- charts ------------------------------------------------------------- */
  .chart { margin: 0; }
  .chart-canvas { display: block; width: 100%; border: 1px solid var(--panel-border); background: rgb(var(--ground-rgb) / 0.6); }
  .chart--trace .chart-canvas { height: 96px; }
  .chart--phase .chart-canvas { height: 240px; }
  .chart-caption { font-size: var(--fs-11); line-height: var(--lh-caption); color: var(--text-caption); margin-top: var(--s-10); }
  .plot { position: relative; padding-left: var(--s-24); padding-bottom: var(--s-20); }
  .axis-y {
    position: absolute; left: 0; top: 0; font-size: var(--fs-10); letter-spacing: var(--ls-1); color: var(--text-label);
  }
  .axis-x { position: relative; height: var(--s-20); font-size: var(--fs-10); letter-spacing: var(--ls-1); color: var(--text-label); }
  .axis-x span { position: absolute; top: var(--s-6); transform: translateX(-50%); white-space: nowrap; }
  .axis-min { left: 0; transform: none; }
  .axis-max { left: 100%; transform: translateX(-100%); }
  .axis-tc { left: calc(100% * var(--tc)); color: rgb(var(--copper-rgb)); }

  /* ---- controls ----------------------------------------------------------- */
  .controls { display: flex; flex-wrap: wrap; gap: var(--s-20); }
  .control {
    font: inherit; font-size: var(--fs-10); letter-spacing: var(--ls-2); text-transform: uppercase;
    color: var(--text-cta); background: none; border: 0; cursor: pointer; text-decoration: none;
    transition: color 0.3s; padding: 0;
  }
  .control:hover { color: var(--text-hover); }

  /* ---- prose -------------------------------------------------------------- */
  .prose { max-width: var(--measure); padding: var(--s-80) 0 var(--s-40); }
  .prose p { font-size: var(--fs-13); line-height: var(--lh-article); color: var(--text); margin-bottom: var(--s-24); }
  .prose p:last-child { margin-bottom: 0; }

  /* ---- gate: shown before anything moves ---------------------------------- */
  .gate {
    position: fixed; inset: 0; z-index: 30;
    background: var(--ground);
    display: flex; align-items: center; justify-content: center;
    padding: var(--s-24);
  }
  .gate.closed { display: none; }
  .gate-inner { max-width: 44ch; }
  .gate-title {
    font-family: var(--font-display); text-transform: uppercase;
    font-size: var(--fs-h2); letter-spacing: var(--ls-2); color: var(--text-display);
    margin-bottom: var(--s-20);
  }
  .gate-text { font-size: var(--fs-13); line-height: var(--lh-body); color: var(--text); margin-bottom: var(--s-32); }
  .gate-actions { display: flex; gap: var(--s-32); align-items: center; }
  .gate-continue, .gate-back {
    font: inherit; font-size: var(--fs-10); letter-spacing: var(--ls-2); text-transform: uppercase;
    background: none; border: 0; cursor: pointer; text-decoration: none;
    color: var(--focus); transition: color 0.3s;
  }
  .gate-continue:hover, .gate-back:hover { color: var(--text-display); }

  @media (max-width: 900px) {
    .bench { grid-template-columns: minmax(0, 1fr); gap: var(--s-32); }
  }
  @media (max-width: 640px) {
    .content { padding: 0 var(--gutter-mobile); }
    .page-header { padding: var(--s-80) 0 var(--s-40); }
    .prose { padding-top: var(--s-60); }
  }
  @media (prefers-reduced-motion: reduce) {
    canvas.lattice { transition: none; }
  }
</style>

<script type="module" is:inline>
  // is:inline because this imports runtime paths out of public/; Vite cannot
  // resolve them at build time and bundling the module breaks the worker URL.
  import {
    T_MIN, T_MAX, T_C, T_C_LABEL, onsager, snapTemperature, sliderValueFor, phaseWordFor,
    valueTextFor, keyFor, addSample, meanOf, xFor, yFor,
  } from '/forge/critical/instrument.js';
  import { wireGate, gateSeen, closeGate } from '/forge/shared/gate.js';
  import { createInkWash, rgbToken } from '/forge/shared/inkwash.js';

  // ---- gate, wired first --------------------------------------------------
  // Anything that throws below costs the reader a feature, not the page.
  const gate = document.getElementById('gate');
  const begin = document.getElementById('begin');
  const GATE = 'critical-gate';
  wireGate({ gate, begin, onStart: () => start(), key: GATE });
  // The footer renders after this slot, so the inline script at the top could
  // not reach it. Only while the gate is actually up: a returning visitor's
  // start() below lifts every inert at once anyway.
  if (!gateSeen(GATE)) document.querySelector('.footer')?.setAttribute('inert', '');

  // ---- constants ------------------------------------------------------------
  const N = 256;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const BONE = rgbToken('--bone-rgb', [232, 228, 216], 'critical');
  const GROUND = rgbToken('--ground-rgb', [6, 6, 6], 'critical');
  const COPPER = rgbToken('--copper-rgb', [154, 106, 62], 'critical');
  // The slider has come to rest after this long without input; then the
  // lattice is settled (a cluster burst in the worker), held for HOLD_MS of
  // ordinary sweeps, and only then sampled.
  const SETTLE_DEBOUNCE_MS = 350;
  const HOLD_MS = 1500;
  const TRACE_LEN = 240;
  const ANNOUNCE_EVERY_MS = 3000;
  // Blend weight of the newest frame, as on Spin: quick when hot so the noise
  // stays a live stipple, slow when cold so the domains breathe.
  const EMA_HOT = 0.6, EMA_COLD = 0.18;
  const emaFor = (T) => EMA_COLD + (EMA_HOT - EMA_COLD) * Math.max(0, Math.min(1, (T - T_MIN) / (T_MAX - T_MIN)));

  // ---- elements ---------------------------------------------------------------
  const stage = document.getElementById('stage');
  const canvas = document.getElementById('lattice');
  const poster = document.getElementById('poster');
  const slider = document.getElementById('temp');
  const tVal = document.getElementById('t-val');
  const mVal = document.getElementById('m-val');
  const phaseWord = document.getElementById('phase-word');
  const stateWord = document.getElementById('state-word');
  const announceEl = document.getElementById('announce');
  const traceCanvas = document.getElementById('trace');
  const phaseCanvas = document.getElementById('phase');

  // ---- state --------------------------------------------------------------------
  let T = T_C;
  let last = null;          // Int8Array of the last frame
  let frames = 0;
  let pending = false;      // a tick is in flight
  let visible = !document.hidden;
  let worker = null;
  let m = 0;                // |m| of the last frame
  // 'settling' → the burst is running or about to; 'hold' → burst spent, waiting
  // out HOLD_MS; 'holding' → sampling into the running mean.
  let phase = 'settling';
  let holdUntil = 0;
  // The settle request we are waiting on. Bumped the moment a change (slider,
  // reset) invalidates the current burst, not when the debounced request is
  // finally sent: a frame from the old burst arriving in that window would
  // otherwise read as the end of the new one. Starts at one because the
  // worker's own counter starts at zero and must never match by accident.
  let settleSeq = 1;
  let samples = 0;          // samples taken at the current temperature
  let lastAnnounce = 0;

  // Points on the phase diagram: key → {T, n, sum}. Kept for the session.
  const points = new Map();
  try {
    for (const p of JSON.parse(sessionStorage.getItem('critical-points') || '[]')) {
      if (p && Number.isFinite(p.T) && Number.isFinite(p.sum) && p.n > 0) points.set(keyFor(p.T), p);
    }
  } catch {}
  function savePoints() {
    try { sessionStorage.setItem('critical-points', JSON.stringify([...points.values()])); } catch {}
  }

  // ---- lattice renderer ----------------------------------------------------------
  const wash = createInkWash(canvas, N, { ground: GROUND, bone: BONE, copper: COPPER, copperWeight: 0.2, grain: 0.02, tag: 'critical' });
  function resizeStage() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const r = stage.getBoundingClientRect();
    wash.resize(Math.max(1, Math.round(r.width * dpr)), Math.max(1, Math.round(r.height * dpr)));
    if (last) wash.paint();
  }

  // ---- charts ----------------------------------------------------------------------
  const rgba = (rgb, a) => `rgb(${rgb[0]} ${rgb[1]} ${rgb[2]} / ${a})`;
  const trace = new Float32Array(TRACE_LEN);
  let traceCount = 0, traceHead = 0;
  function pushTrace(v) {
    trace[traceHead] = v;
    traceHead = (traceHead + 1) % TRACE_LEN;
    if (traceCount < TRACE_LEN) traceCount++;
  }
  function fitChart(c) {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const r = c.getBoundingClientRect();
    const w = Math.max(1, Math.round(r.width * dpr)), h = Math.max(1, Math.round(r.height * dpr));
    if (c.width !== w || c.height !== h) { c.width = w; c.height = h; }
    const ctx = c.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    return { ctx, w: r.width, h: r.height };
  }
  function drawTrace() {
    const { ctx, w, h } = fitChart(traceCanvas);
    const pad = 6;
    ctx.clearRect(0, 0, w, h);
    // Where the exact solution says |m| rests at this temperature.
    const rest = pad + (h - 2 * pad) * yFor(onsager(T));
    ctx.strokeStyle = rgba(BONE, 0.18); ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(0, Math.round(rest) + 0.5); ctx.lineTo(w, Math.round(rest) + 0.5); ctx.stroke();
    if (traceCount === 0) return;
    ctx.strokeStyle = rgba(BONE, 0.85); ctx.lineWidth = 1.25; ctx.lineJoin = 'round';
    ctx.beginPath();
    const start = (traceHead - traceCount + TRACE_LEN) % TRACE_LEN;
    for (let i = 0; i < traceCount; i++) {
      const v = trace[(start + i) % TRACE_LEN];
      const x = w - ((traceCount - 1 - i) * (w / (TRACE_LEN - 1)));
      const y = pad + (h - 2 * pad) * yFor(v);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    ctx.stroke();
  }
  function drawPhase() {
    const { ctx, w, h } = fitChart(phaseCanvas);
    const pad = 8;
    const px = (t) => pad + (w - 2 * pad) * xFor(t);
    const py = (v) => pad + (h - 2 * pad) * yFor(v);
    ctx.clearRect(0, 0, w, h);
    // The critical temperature, faint.
    ctx.strokeStyle = rgba(COPPER, 0.35); ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(Math.round(px(T_C)) + 0.5, pad); ctx.lineTo(Math.round(px(T_C)) + 0.5, h - pad); ctx.stroke();
    // Ticks on the magnetisation axis: none, a half, one. No figures.
    ctx.strokeStyle = rgba(BONE, 0.25);
    for (const v of [0, 0.5, 1]) { ctx.beginPath(); ctx.moveTo(pad, Math.round(py(v)) + 0.5); ctx.lineTo(pad + 6, Math.round(py(v)) + 0.5); ctx.stroke(); }
    // Onsager's exact curve for the infinite lattice.
    ctx.strokeStyle = rgba(BONE, 0.3); ctx.lineWidth = 1;
    ctx.beginPath();
    const steps = 300;
    for (let i = 0; i <= steps; i++) {
      const t = T_MIN + (T_MAX - T_MIN) * (i / steps);
      const x = px(t), y = py(onsager(t));
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    ctx.stroke();
    // The visitor's points: the running mean at every temperature held.
    const cur = keyFor(T);
    for (const [key, p] of points) {
      const x = px(p.T), y = py(meanOf(p));
      if (key === cur && phase === 'holding') { ctx.fillStyle = rgba(COPPER, 1); ctx.fillRect(x - 3, y - 3, 6, 6); }
      else { ctx.fillStyle = rgba(BONE, 0.9); ctx.fillRect(x - 2, y - 2, 4, 4); }
    }
  }

  // ---- readout --------------------------------------------------------------------
  const tLabel = (t) => t === T_C ? T_C_LABEL : t.toFixed(2);
  function updateReadout() {
    tVal.textContent = tLabel(T);
    mVal.textContent = last ? m.toFixed(2) : '—';
    const pw = phaseWordFor(T);
    if (phaseWord.textContent !== pw) phaseWord.textContent = pw;
    const sw = phase === 'holding' ? 'HOLDING' : 'SETTLING';
    if (stateWord.textContent !== sw) stateWord.textContent = sw;
  }
  // The live region gets sentences, and not often: one on each settled
  // temperature, one when the hold begins, then the running mean every few
  // seconds. Writing every frame would talk over itself.
  function announce(text) {
    announceEl.textContent = text;
    lastAnnounce = performance.now();
  }

  // ---- temperature ------------------------------------------------------------------
  let settleTimer = null;
  function setTemperature(raw, { fromSlider = false } = {}) {
    const next = snapTemperature(raw, T);
    const changed = next !== T;
    T = next;
    const v = sliderValueFor(T);
    if (!fromSlider || slider.value !== v) slider.value = v;
    slider.setAttribute('aria-valuetext', valueTextFor(T));
    if (changed || phase !== 'settling') onTemperatureChanged();
  }
  function onTemperatureChanged() {
    phase = 'settling';
    settleSeq++;
    samples = 0;
    updateReadout();
    drawTrace();
    drawPhase();
    clearTimeout(settleTimer);
    settleTimer = setTimeout(requestSettle, SETTLE_DEBOUNCE_MS);
  }
  function requestSettle() {
    if (!worker) return;
    if (reduced) {
      worker.postMessage({ type: 'sample', T, seq: settleSeq });
      announce(`Temperature ${valueTextFor(T)}, ${phaseWordFor(T).toLowerCase()}. Sampling.`);
      return;
    }
    worker.postMessage({ type: 'settle', T, seq: settleSeq });
    phase = 'settling';
    updateReadout();
    announce(`Temperature ${valueTextFor(T)}, ${phaseWordFor(T).toLowerCase()}. Settling.`);
  }
  slider.addEventListener('input', () => setTemperature(Number(slider.value), { fromSlider: true }));

  // ---- points ----------------------------------------------------------------------------
  function addPoint(t, value) {
    const key = keyFor(t);
    const p = points.get(key) || { T: t, n: 0, sum: 0 };
    points.set(key, addSample(p, value));
    samples++;
    if (samples % 30 === 0) savePoints();
  }

  // ---- worker (started only after the gate) -----------------------------------------------
  function start() {
    if (worker) return;
    closeGate(gate);
    for (const el of document.querySelectorAll('[inert]')) el.removeAttribute('inert');
    resizeStage();
    drawTrace();
    drawPhase();
    worker = new Worker('/forge/spin/worker.js', { type: 'module' });
    worker.onmessage = onWorkerMessage;
    worker.onerror = (e) => console.error('critical worker failed:', e.message);
    // h = 0 always: this is the pure model, and the cluster burst needs it.
    worker.postMessage({ type: 'init', n: N, seed: Date.now() % 4294967296, maxSweeps: reduced ? 1 : 4, h: 0 });
  }
  function onWorkerMessage(e) {
    const msg = e.data;
    if (msg.type === 'ready') {
      pending = false;
      requestSettle();
      if (!reduced) schedule();
      return;
    }
    if (msg.type === 'frame') {
      last = new Int8Array(msg.spins);
      frames++;
      // Reset frames and samples answer no tick; only a tick's frame clears it.
      if (!msg.reset && !msg.single) pending = false;
      m = Math.abs(msg.m);
      pushTrace(m);
      if (msg.single) {
        // Reduced motion: one still, one point, from the worker's own mean.
        if (msg.seq === settleSeq) {
          phase = 'holding';
          addPoint(T, m);
          savePoints();
          announce(`Holding at ${valueTextFor(T)}. Magnetisation ${m.toFixed(2)}.`);
        }
        wash.blend(last, 1, true);
      } else {
        if (phase === 'settling' && msg.seq === settleSeq && msg.settling === false) {
          phase = 'hold';
          holdUntil = performance.now() + HOLD_MS;
        }
        if (phase === 'hold' && performance.now() >= holdUntil) {
          phase = 'holding';
          announce(`Holding at ${valueTextFor(T)}.`);
        }
        if (phase === 'holding' && !msg.reset && msg.T === T) {
          addPoint(T, m);
          if (performance.now() - lastAnnounce > ANNOUNCE_EVERY_MS) {
            announce(`Holding at ${valueTextFor(T)}. Magnetisation ${meanOf(points.get(keyFor(T))).toFixed(2)}.`);
          }
        }
        wash.blend(last, emaFor(T), frames === 1 || msg.reset);
      }
      wash.paint();
      if (frames === 1) { canvas.classList.add('live'); poster.hidden = true; }
      drawTrace();
      if (msg.single || phase !== 'holding' || frames % 10 === 0) drawPhase();
      updateReadout();
      return;
    }
    if (msg.type === 'error') console.error('critical worker:', msg.message);
  }

  // schedule() is the only way in; loop() is only ever called by rAF.
  let looping = false;
  function schedule() {
    if (looping || reduced) return;
    looping = true;
    requestAnimationFrame(loop);
  }
  function loop() {
    looping = false;
    if (!visible || !worker) return;
    if (!pending) { pending = true; worker.postMessage({ type: 'tick', T, h: 0 }); }
    schedule();
  }
  document.addEventListener('visibilitychange', () => {
    visible = !document.hidden;
    if (visible) schedule(); else savePoints();
  });
  addEventListener('pagehide', savePoints);

  // ---- controls ---------------------------------------------------------------------
  function reset() {
    if (!worker) return;
    worker.postMessage({ type: 'reset' });
    onTemperatureChanged();
  }
  function clearPoints() {
    points.clear();
    samples = 0;
    savePoints();
    drawPhase();
    announce('Points cleared.');
  }
  document.getElementById('reset').addEventListener('click', reset);
  document.getElementById('clear').addEventListener('click', clearPoints);

  // ---- layout ------------------------------------------------------------------------
  const ro = new ResizeObserver(() => { resizeStage(); drawTrace(); drawPhase(); });
  ro.observe(stage);
  ro.observe(traceCanvas);
  ro.observe(phaseCanvas);

  // ---- test hook -------------------------------------------------------------------------
  window.__critical = {
    get frames() { return frames; },
    get renderer() { return wash.renderer; },
    get m() { return m; },
    get phase() { return phase; },
    get reduced() { return reduced; },
    get announcement() { return announceEl.textContent; },
    temperature: () => T,
    setTemperature: (t) => setTemperature(t),
    points: () => [...points.values()].map((p) => ({ T: p.T, n: p.n, mean: meanOf(p) })),
    reset, clearPoints,
  };

  // ---- gate: the second visit ------------------------------------------------------------
  updateReadout();
  if (gateSeen(GATE)) start(); else begin.focus();
</script>
