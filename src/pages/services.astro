---
import Base from '../layouts/Base.astro';
---
<Base
  title="Services — Archaic"
  description="Software services from a Dublin studio. Reviews, advisory, and builds. Scoped in writing, delivered by email. No calls, no day rates."
  path="/services/"
  current="services"
>
  <div class="content">

    <!-- Page header -->
    <header class="page-header">
      <h1 class="page-title">SERVICES</h1>
      <p class="page-intro">Scope agreed in writing. No calls, no day rates. You describe the problem, we deliver the solution — through email.</p>
    </header>

    <!-- Services -->
    <section class="section">
      <p class="section-label">What We Offer</p>

      <article class="service reveal">
        <h2 class="service-name">REVIEW</h2>
        <p class="service-tagline">See what you're actually running</p>
        <p class="service-body">An independent look at software you already have. Where it's fragile, where it's slow, where it will cost you later. You get a written report with clear priorities — not a list of vague recommendations.</p>
        <a class="service-cta" href="mailto:hello@archaic.ie?subject=Review">
          Ask about a review <span class="arrow" aria-hidden="true">→</span>
        </a>
      </article>

      <article class="service reveal">
        <h2 class="service-name">ADVISORY</h2>
        <p class="service-tagline">Know where to spend, and where not to</p>
        <p class="service-body">Straight answers on where technology and automation can help your business, and where they can't. No hype, no vendor pitch. You get a practical view of what's worth doing, and in what order.</p>
        <a class="service-cta" href="mailto:hello@archaic.ie?subject=Advisory">
          Ask about advisory <span class="arrow" aria-hidden="true">→</span>
        </a>
      </article>

      <article class="service reveal">
        <h2 class="service-name">BUILD</h2>
        <p class="service-tagline">From agreed scope to working software</p>
        <p class="service-body">A focused engagement to build a clearly defined product or feature. The scope is agreed in writing before any work starts. You get finished, deployed, documented software — not a prototype that needs another six months.</p>
        <a class="service-cta" href="mailto:hello@archaic.ie?subject=Build">
          Start a conversation <span class="arrow" aria-hidden="true">→</span>
        </a>
      </article>
    </section>

    <!-- How it works -->
    <section class="how-it-works">
      <p class="section-label">How It Works</p>

      <div class="step reveal">
        <p class="step-number">01</p>
        <p class="step-text"><strong>Email us</strong> — describe what you have, what's not working, and your timeline.</p>
      </div>
      <div class="step reveal">
        <p class="step-number">02</p>
        <p class="step-text"><strong>We scope it</strong> — we'll ask a few questions over email and send you a written proposal. No surprises.</p>
      </div>
      <div class="step reveal">
        <p class="step-number">03</p>
        <p class="step-text"><strong>We deliver</strong> — you get the finished work on the agreed date.</p>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="contact reveal">
      <p class="contact-text">
        Ready to start? Email <a class="contact-link" href="mailto:hello@archaic.ie">hello@archaic.ie</a> with:
      </p>
      <div class="contact-template">
        <strong>What you've built</strong> — a brief description of your product or business<br/>
        <strong>What's not working</strong> — the problem you want solved<br/>
        <strong>Your timeline</strong> — when you need it done by
      </div>
    </section>

  </div>
</Base>

<style>
  /* ── CONTENT WRAPPER ── */
  .content {
    position: relative;
    z-index: 10;
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* ── PAGE HEADER ── */
  .page-header {
    padding: var(--s-120) 0 var(--s-40);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 400;
    color: var(--text-display);
    letter-spacing: var(--ls-4);
    text-transform: uppercase;
  }

  .page-intro {
    font-size: var(--fs-14);
    color: var(--text);
    line-height: var(--lh-body);
    max-width: 520px;
    margin-top: var(--s-24);
  }

  /* ── SECTION ── */
  .section {
    padding: var(--s-60) 0;
  }

  .section-label {
    font-size: var(--fs-9);
    letter-spacing: var(--ls-3);
    text-transform: uppercase;
    color: var(--text-label);
    margin-bottom: var(--s-48);
    display: flex;
    align-items: center;
    gap: var(--s-14);
  }

  .section-label::before {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    background: var(--rule-label);
    flex-shrink: 0;
  }

  /* ── SERVICE BLOCK ── */
  .service {
    margin-bottom: var(--s-72);
  }

  .service:last-child {
    margin-bottom: 0;
  }

  .service-name {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 400;
    color: var(--text-display);
    letter-spacing: var(--ls-2);
    text-transform: uppercase;
    margin-bottom: var(--s-6);
  }

  .service-tagline {
    font-size: var(--fs-13);
    color: var(--text);
    margin-bottom: var(--s-24);
    font-style: italic;
  }

  .service-body {
    font-size: var(--fs-13);
    color: var(--text);
    line-height: var(--lh-body);
    margin-bottom: var(--s-24);
  }

  .service-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-10);
    font-size: var(--fs-10);
    letter-spacing: var(--ls-2);
    text-transform: uppercase;
    color: var(--text-cta);
    text-decoration: none;
    transition: color 0.3s;
  }

  .service-cta:hover {
    color: var(--text-hover);
  }

  .service-cta .arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .service-cta:hover .arrow {
    transform: translateX(6px);
  }

  /* ── HOW IT WORKS ── */
  .how-it-works {
    padding: var(--s-60) 0;
    border-top: 1px solid var(--rule-strong);
  }

  .step {
    margin-bottom: var(--s-32);
  }

  .step:last-child {
    margin-bottom: 0;
  }

  .step-number {
    font-family: var(--font-display);
    font-size: var(--fs-14);
    color: var(--text-faint);
    letter-spacing: var(--ls-2);
    margin-bottom: var(--s-8);
  }

  .step-text {
    font-size: var(--fs-13);
    color: var(--text);
    line-height: var(--lh-body);
  }

  .step-text strong {
    color: var(--text-strong);
    font-weight: 500;
  }

  /* ── CONTACT CTA ── */
  .contact {
    padding: var(--s-60) 0 var(--s-40);
    border-top: 1px solid var(--rule-strong);
  }

  .contact-text {
    font-size: var(--fs-14);
    color: var(--text);
    line-height: var(--lh-body);
  }

  .contact-link {
    color: var(--text-cta);
    text-decoration: none;
    transition: color 0.3s;
  }

  .contact-link:hover {
    color: var(--text-hover);
  }

  .contact-template {
    margin-top: var(--s-24);
    padding: var(--s-20);
    border: 1px solid var(--panel-border);
    background: var(--panel);
    font-size: var(--fs-12);
    color: var(--text-strong);
    line-height: 1.8;
  }

  .contact-template strong {
    color: var(--text);
  }

  /* ── MOBILE ── */
  @media (max-width: 640px) {
    .content {
      padding: 0 var(--gutter-mobile);
    }

    .page-header {
      padding: var(--s-80) 0 var(--s-48);
    }
  }
</style>
