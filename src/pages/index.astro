---
import Base from '../layouts/Base.astro';
---
<Base
  title="Archaic — Software Studio, Dublin"
  description="Archaic Limited builds software that endures. No trends. No bloat. Just work that holds."
  path="/"
  layout="hero"
  ghostFont
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"Organization","name":"Archaic Limited","alternateName":"Archaic","url":"https://archaic.ie/","logo":"https://archaic.ie/apple-touch-icon.png","email":"hello@archaic.ie","foundingDate":"2026-03-25","areaServed":"IE"}</script>
  </Fragment>

  <div slot="page-start" class="ghost-text" aria-hidden="true">ARCHAIC</div>

  <main class="hero">
    <p class="hero-eyebrow">Software Studio — Dublin</p>
    <h1 class="hero-headline">BUILT TO LAST.<br />NOT TO IMPRESS.</h1>
    <p class="hero-body">
      Archaic Limited builds software that endures.<br />
      No trends. No bloat. Just work that holds.
    </p>
    <a class="hero-cta" href="mailto:hello@archaic.ie">
      Get in touch <span class="arrow" aria-hidden="true">→</span>
    </a>
  </main>
</Base>

<style is:global>
  /* Homepage entrance choreography on the shared chrome. Global because Nav and
     Footer render inside Base, so a scoped rule would never reach them. */
  .page--hero .nav    { opacity: 0; animation: fadeUp 0.8s ease forwards; animation-delay: 0.1s; }
  .page--hero .footer { opacity: 0; animation: fadeUp 0.8s ease forwards; animation-delay: 1.1s; }
</style>

<style>
  /* ── GHOST TEXT ── */
  .ghost-text {
    position: absolute;
    font-family: var(--font-ghost);
    font-size: 13vw;
    font-weight: 400;
    color: transparent;
    -webkit-text-stroke: 1px rgb(var(--white-rgb) / 0.045);
    letter-spacing: 0.06em;
    right: 0;
    left: 0;
    text-align: center;
    bottom: -0.1em;
    line-height: 1;
    pointer-events: none;
    user-select: none;
    z-index: 1;
    opacity: 0;
    transform: translateY(30px);
    animation: ghostReveal 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.8s;
  }

  @keyframes ghostReveal {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── HERO ── */
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 var(--gutter);
    position: relative;
    z-index: 10;
  }

  .hero-eyebrow {
    font-size: var(--fs-10);
    letter-spacing: var(--ls-4);
    text-transform: uppercase;
    color: var(--text-label);
    margin-bottom: var(--s-28);
    display: flex;
    align-items: center;
    gap: var(--s-14);
    opacity: 0;
    animation: fadeUp 0.8s ease forwards;
    animation-delay: 0.5s;
  }

  .hero-eyebrow::before {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    background: var(--rule-label);
    flex-shrink: 0;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: var(--fs-hero);
    font-weight: 400;
    color: var(--text-display);
    line-height: 1.2;
    letter-spacing: var(--ls-2);
    margin-bottom: var(--s-28);
    max-width: 580px;
    opacity: 0;
    animation: fadeUp 0.9s ease forwards;
    animation-delay: 0.65s;
  }

  .hero-body {
    font-size: var(--fs-14);
    color: var(--text);
    line-height: var(--lh-body);
    max-width: 400px;
    margin-bottom: var(--s-44);
    opacity: 0;
    animation: fadeUp 0.9s ease forwards;
    animation-delay: 0.8s;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-14);
    font-size: var(--fs-10);
    letter-spacing: var(--ls-3);
    text-transform: uppercase;
    color: var(--text-cta);
    text-decoration: none;
    opacity: 0;
    animation: fadeUp 0.9s ease forwards;
    animation-delay: 0.95s;
    transition: color 0.3s;
    width: fit-content;
  }

  .hero-cta:hover {
    color: var(--text-hover);
  }

  .hero-cta .arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .hero-cta:hover .arrow {
    transform: translateX(6px);
  }

  /* ── MOBILE ── */
  @media (max-width: 640px) {
    .hero {
      padding: var(--s-60) var(--gutter-mobile);
    }

    .ghost-text {
      font-size: 35vw;
      -webkit-text-stroke: 1px rgb(var(--white-rgb) / 0.03);
    }
  }
</style>
