---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const articles = (await getCollection('journal'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const rendered = await Promise.all(
  articles.map(async (article) => {
    const { Content } = await render(article);
    return { article, Content };
  })
);
---
<Base
  title="Deeper — Archaic"
  description="What Archaic builds. Case studies, articles, and thinking from a Dublin software studio."
  path="/deeper/"
  current="deeper"
>
  <div class="content">

    <!-- Page header -->
    <header class="page-header">
      <h1 class="page-title">DEEPER</h1>
    </header>

    <!-- Work section -->
    <section class="section">
      <p class="section-label">Work</p>

      <article id="planningwatch" class="case-study reveal">
        <h2 class="case-study-name">PLANNINGWATCH</h2>
        <p class="case-study-tagline">Planning-application monitoring for Irish property</p>
        <p class="case-study-detail"><strong>What it is</strong> — Subscription service that watches every Irish local authority's planning register and tells you when something is lodged, or decided, near a property you care about.</p>
        <p class="case-study-detail"><strong>What it does</strong> — Nightly ingestion from council planning portals, address and map matching against watched properties, daily digests and a weekly summary, decision outcomes, and an API with webhooks for teams that want the data in their own systems.</p>
        <p class="case-study-tech">Django · Celery · PostgreSQL · Redis · Railway</p>
        <a class="case-study-link" href="https://planningwatch.ie" target="_blank" rel="noopener noreferrer">
          Visit PlanningWatch <span class="arrow" aria-hidden="true">→</span>
        </a>
      </article>

      <article id="salaries-ie" class="case-study reveal">
        <h2 class="case-study-name">SALARIES.IE</h2>
        <p class="case-study-tagline">Salary pages from Irish open data</p>
        <p class="case-study-detail"><strong>What it is</strong> — Programmatic SEO site generating salary comparison pages from CSO open data, broken down by sector, county, and demographics.</p>
        <p class="case-study-detail"><strong>What it does</strong> — Automated data pipelines from the Central Statistics Office, per-county and per-sector salary breakdowns, every page statically generated.</p>
        <p class="case-study-tech">Astro · Cloudflare Pages · CSO Open Data API</p>
        <a class="case-study-link" href="https://salaries.ie" target="_blank" rel="noopener noreferrer">
          Visit salaries.ie <span class="arrow" aria-hidden="true">→</span>
        </a>
      </article>

      <article id="roleup" class="case-study reveal">
        <h2 class="case-study-name">ROLEUP</h2>
        <p class="case-study-tagline">Irish job board with recruiter accountability</p>
        <p class="case-study-detail"><strong>What it is</strong> — Privacy-first job board where every company gets a public response score based on how they treat candidates.</p>
        <p class="case-study-detail"><strong>What it does</strong> — Recruiter response scoring, salary data ingestion pipelines, benchmarking by role and county, email alerts, recruiter tier system.</p>
        <p class="case-study-tech">Django · HTMX · Stripe · PostgreSQL · Railway</p>
        <a class="case-study-link" href="https://www.roleup.ie" target="_blank" rel="noopener noreferrer">
          Visit RoleUp <span class="arrow" aria-hidden="true">→</span>
        </a>
      </article>

      <article id="djangoship" class="case-study reveal">
        <h2 class="case-study-name">DJANGOSHIP</h2>
        <p class="case-study-tagline">SaaS boilerplate for European startups</p>
        <p class="case-study-detail"><strong>What it is</strong> — Production-ready Django template sold on Gumroad. Ships with Stripe payments, privacy/compliance foundations, team management, and one-click Railway deploy.</p>
        <p class="case-study-detail"><strong>What it does</strong> — Authentication with email and OAuth, subscription billing, API tokens with quota tracking, cookie consent and data export, a full automated test suite.</p>
        <p class="case-study-tech">Django · Stripe · PostgreSQL · Railway · GitHub Actions</p>
        <a class="case-study-link" href="https://gumroad.com/l/djangoship" target="_blank" rel="noopener noreferrer">
          View on Gumroad <span class="arrow" aria-hidden="true">→</span>
        </a>
      </article>
    </section>

    <!-- Journal section -->
    <section class="section">
      <p class="section-label">Journal</p>
      {rendered.length === 0 ? (
        <p class="journal-empty reveal">Nothing yet. Articles will appear here.</p>
      ) : (
        rendered.map(({ article, Content }) => (
          <article id={article.data.slug} class="journal-article reveal">
            <h2 class="journal-article-title">{article.data.title}</h2>
            <p class="journal-article-date">{article.data.date.toLocaleDateString('en-IE', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            <div class="journal-article-body">
              <Content />
            </div>
          </article>
        ))
      )}
    </section>

    <!-- Contact CTA -->
    <section class="contact reveal">
      <p class="contact-text">
        If any of this is relevant to what you're building —
        <a class="contact-link" href="mailto:hello@archaic.ie">hello@archaic.ie<span class="arrow" aria-hidden="true"> →</span></a>
      </p>
    </section>

  </div>
</Base>

<style>
  /* ── CONTENT WRAPPER ── */
  .content {
    position: relative;
    z-index: 10;
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* ── PAGE HEADER ── */
  .page-header {
    padding: var(--s-120) 0 var(--s-80);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 400;
    color: var(--text-display);
    letter-spacing: var(--ls-4);
    text-transform: uppercase;
  }

  /* ── SECTION ── */
  .section {
    padding: var(--s-60) 0;
  }

  .section-label {
    font-size: var(--fs-9);
    letter-spacing: var(--ls-3);
    text-transform: uppercase;
    color: var(--text-label);
    margin-bottom: var(--s-48);
    display: flex;
    align-items: center;
    gap: var(--s-14);
  }

  .section-label::before {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    background: var(--rule-label);
    flex-shrink: 0;
  }

  /* ── CASE STUDY ── */
  .case-study {
    margin-bottom: var(--s-64);
  }

  .case-study:last-child {
    margin-bottom: 0;
  }

  .case-study-name {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 400;
    color: var(--text-display);
    letter-spacing: var(--ls-2);
    text-transform: uppercase;
    margin-bottom: var(--s-6);
  }

  .case-study-tagline {
    font-size: var(--fs-13);
    color: var(--text);
    margin-bottom: var(--s-24);
    font-style: italic;
  }

  .case-study-detail {
    font-size: var(--fs-13);
    color: var(--text);
    line-height: var(--lh-body);
    margin-bottom: var(--s-8);
  }

  .case-study-detail strong {
    color: var(--text-strong);
    font-weight: 500;
    display: inline-block;
    min-width: 100px;
  }

  .case-study-tech {
    font-size: var(--fs-12);
    color: var(--text-caption);
    margin-top: var(--s-16);
    letter-spacing: var(--ls-05);
  }

  .case-study-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-10);
    font-size: var(--fs-10);
    letter-spacing: var(--ls-2);
    text-transform: uppercase;
    color: var(--text-cta);
    text-decoration: none;
    margin-top: var(--s-20);
    transition: color 0.3s;
  }

  .case-study-link:hover {
    color: var(--text-hover);
  }

  .case-study-link .arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .case-study-link:hover .arrow {
    transform: translateX(6px);
  }

  /* ── JOURNAL (empty state) ── */
  .journal-empty {
    font-size: var(--fs-13);
    color: var(--text-faint);
    font-style: italic;
  }

  /* ── JOURNAL ARTICLE ── */
  .journal-article {
    margin-bottom: var(--s-64);
  }

  .journal-article:last-child {
    margin-bottom: 0;
  }

  .journal-article-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 400;
    color: var(--text-display);
    letter-spacing: var(--ls-2);
    text-transform: uppercase;
    margin-bottom: var(--s-6);
  }

  .journal-article-date {
    font-size: var(--fs-11);
    color: var(--text-faint);
    letter-spacing: var(--ls-1);
    margin-bottom: var(--s-24);
  }

  .journal-article-body {
    font-size: var(--fs-14);
    color: var(--text);
    line-height: var(--lh-article);
  }

  /* Article bodies come from the content collection, so their <p> elements carry
     no scope attribute and any rule for them has to reach through with :global().

     `margin: 1em 0` is the browser default, reproduced on purpose. Before this
     page moved onto Base its own reset and its own `.journal-article-body p`
     rule were BOTH scoped, so neither ever matched a collection-rendered
     paragraph and the journal has always rendered with UA margins. global.css
     zeroes them for real, so the spacing has to be restated here to keep the
     page pixel-identical. Raise it to var(--s-16) when journal typography is
     deliberately revisited; that is a visible change, not a migration. */
  .journal-article-body :global(p) {
    margin: 1em 0;
  }

  /* ── CONTACT CTA ── */
  .contact {
    padding: var(--s-80) 0 var(--s-40);
    border-top: 1px solid var(--rule-strong);
  }

  .contact-text {
    font-size: var(--fs-14);
    color: var(--text);
    line-height: var(--lh-body);
  }

  .contact-link {
    color: var(--text-cta);
    text-decoration: none;
    transition: color 0.3s;
  }

  .contact-link:hover {
    color: var(--text-hover);
  }

  /* ── MOBILE ── */
  @media (max-width: 640px) {
    .content {
      padding: 0 var(--gutter-mobile);
    }

    .page-header {
      padding: var(--s-80) 0 var(--s-48);
    }
  }
</style>
