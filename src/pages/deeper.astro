---
import Base from '../layouts/Base.astro';
---
<Base
  title="Deeper — Archaic"
  description="What Archaic builds. Case studies, articles, and thinking from a Dublin software studio."
  path="/deeper/"
  current="deeper"
>
  <div class="content">

    <!-- Page header -->
    <header class="page-header">
      <h1 class="page-title">DEEPER</h1>
    </header>

    <!-- Work section -->
    <section class="section">
      <p class="section-label">Work</p>

      <article id="planningwatch" class="case-study reveal">
<h2 class="case-study-name">PLANNINGWATCH</h2>
        <p class="case-study-tagline">Planning applications, watched for you.</p>
        <p class="case-study-detail">Know when something is lodged or decided near a property you care about, across every Irish council.</p>
        <a class="case-study-link" href="https://planningwatch.ie" target="_blank" rel="noopener noreferrer">
          Visit PlanningWatch <span class="arrow" aria-hidden="true">→</span>
        </a>
      </article>

      <article id="salaries-ie" class="case-study reveal">
<h2 class="case-study-name">SALARIES.IE</h2>
        <p class="case-study-tagline">What Ireland earns.</p>
        <p class="case-study-detail">Pay by sector, county and role, drawn from official statistics and kept current.</p>
        <a class="case-study-link" href="https://salaries.ie" target="_blank" rel="noopener noreferrer">
          Visit salaries.ie <span class="arrow" aria-hidden="true">→</span>
        </a>
      </article>

      <article id="roleup" class="case-study reveal">
<h2 class="case-study-name">ROLEUP</h2>
        <p class="case-study-tagline">An Irish job board that keeps score.</p>
        <p class="case-study-detail">Every employer gets a public response record, so candidates can see who actually replies.</p>
        <a class="case-study-link" href="https://www.roleup.ie" target="_blank" rel="noopener noreferrer">
          Visit RoleUp <span class="arrow" aria-hidden="true">→</span>
        </a>
      </article>

      <article id="djangoship" class="case-study reveal">
<h2 class="case-study-name">DJANGOSHIP</h2>
        <p class="case-study-tagline">A foundation for building SaaS in Europe.</p>
        <p class="case-study-detail">The base we build our own products on, with payments, privacy and deployment handled from day one.</p>
        <a class="case-study-link" href="https://gumroad.com/l/djangoship" target="_blank" rel="noopener noreferrer">
          View on Gumroad <span class="arrow" aria-hidden="true">→</span>
        </a>
      </article>
    </section>

    <!-- Journal section -->
    <section class="section">
      <p class="section-label">Journal</p>
      <p class="journal-note reveal">The writing lives on connorfaulkner.com. Two pieces started here.</p>
      <ul class="journal-list">
        <li id="irish-software-deserves-better" class="journal-item reveal">
          <h2 class="journal-item-title"><a class="journal-item-link" href="https://connorfaulkner.com/blog/irish-software-deserves-better/" target="_blank" rel="noopener noreferrer">IRISH SOFTWARE DESERVES BETTER</a></h2>
          <p class="journal-item-date">31 March 2026</p>
          <p class="journal-item-desc">Try to do anything online in Ireland. The problem is who builds the systems, and who they are built for.</p>
        </li>
        <li id="what-built-to-last-means" class="journal-item reveal">
          <h2 class="journal-item-title"><a class="journal-item-link" href="https://connorfaulkner.com/blog/what-built-to-last-means/" target="_blank" rel="noopener noreferrer">WHAT BUILT TO LAST MEANS</a></h2>
          <p class="journal-item-date">31 March 2026</p>
          <p class="journal-item-desc">Why the company is called Archaic. Newgrange still works. Most software does not survive the demo.</p>
        </li>
      </ul>
    </section>

    <!-- Contact CTA -->
    <section class="contact reveal">
      <p class="contact-text">
        If any of this is relevant to what you're building —
        <a class="contact-link" href="mailto:hello@archaic.ie">hello@archaic.ie<span class="arrow" aria-hidden="true"> →</span></a>
      </p>
    </section>

  </div>
</Base>

<style>
  /* ── CONTENT WRAPPER ── */
  .content {
    position: relative;
    z-index: 10;
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* ── PAGE HEADER ── */
  .page-header {
    padding: var(--s-120) 0 var(--s-80);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 400;
    color: var(--text-display);
    letter-spacing: var(--ls-4);
    text-transform: uppercase;
  }

  /* ── SECTION ── */
  .section {
    padding: var(--s-60) 0;
  }

  .section-label {
    font-size: var(--fs-9);
    letter-spacing: var(--ls-3);
    text-transform: uppercase;
    color: var(--text-label);
    margin-bottom: var(--s-48);
    display: flex;
    align-items: center;
    gap: var(--s-14);
  }

  .section-label::before {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    background: var(--rule-label);
    flex-shrink: 0;
  }

  /* ── CASE STUDY ── */
  .case-study {
    margin-bottom: var(--s-64);
  }

  .case-study:last-child {
    margin-bottom: 0;
  }

  .case-study-name {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 400;
    color: var(--text-display);
    letter-spacing: var(--ls-2);
    text-transform: uppercase;
    margin-bottom: var(--s-6);
  }

  .case-study-tagline {
    font-size: var(--fs-13);
    color: var(--text);
    margin-bottom: var(--s-24);
    font-style: italic;
  }

  .case-study-detail {
    font-size: var(--fs-13);
    color: var(--text);
    line-height: var(--lh-body);
    margin-bottom: var(--s-8);
  }



  .case-study-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-10);
    font-size: var(--fs-10);
    letter-spacing: var(--ls-2);
    text-transform: uppercase;
    color: var(--text-cta);
    text-decoration: none;
    margin-top: var(--s-20);
    transition: color 0.3s;
  }

  .case-study-link:hover {
    color: var(--text-hover);
  }

  .case-study-link .arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .case-study-link:hover .arrow {
    transform: translateX(6px);
  }

  /* ── JOURNAL (link-out) ── */
  .journal-note {
    font-size: var(--fs-14);
    color: var(--text);
    line-height: var(--lh-body);
    margin-bottom: var(--s-40);
  }

  .journal-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .journal-item {
    margin-bottom: var(--s-40);
  }

  .journal-item:last-child {
    margin-bottom: 0;
  }

  .journal-item-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 400;
    letter-spacing: var(--ls-2);
    text-transform: uppercase;
    margin-bottom: var(--s-6);
  }

  .journal-item-link {
    color: var(--text-display);
    text-decoration: none;
    transition: color 0.3s;
  }

  .journal-item-link:hover {
    color: var(--text-cta);
  }

  .journal-item-date {
    font-size: var(--fs-11);
    color: var(--text-faint);
    letter-spacing: var(--ls-1);
    margin-bottom: var(--s-10);
  }

  .journal-item-desc {
    font-size: var(--fs-14);
    color: var(--text);
    line-height: var(--lh-body);
  }

  /* ── CONTACT CTA ── */
  .contact {
    padding: var(--s-80) 0 var(--s-40);
    border-top: 1px solid var(--rule-strong);
  }

  .contact-text {
    font-size: var(--fs-14);
    color: var(--text);
    line-height: var(--lh-body);
  }

  .contact-link {
    color: var(--text-cta);
    text-decoration: none;
    transition: color 0.3s;
  }

  .contact-link:hover {
    color: var(--text-hover);
  }

  /* ── MOBILE ── */
  @media (max-width: 640px) {
    .content {
      padding: 0 var(--gutter-mobile);
    }

    .page-header {
      padding: var(--s-80) 0 var(--s-48);
    }
  }
</style>
